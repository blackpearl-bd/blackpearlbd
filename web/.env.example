[TEMPLATE]
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=https://your-worker.workers.dev

# NOTE: there is no VITE_GEOAPIFY_API_KEY any more. Place search, routing and
# reverse geocoding are proxied through the Worker's /geo routes, so the
# Geoapify key lives as a Worker secret (GEOAPIFY_API_KEY) and never ships in
# the browser bundle.
